# .NET / MAUI build output
**/bin/
**/obj/
*.user

# MSBuild binary logs — produced by `dotnet build -bl`/`/bl`, or by an IDE's
# "Diagnose Build Performance" action. Large and machine-specific; never
# meant to be committed.
*.binlog

# Generated by the BuildWebApp MSBuild target (Ergnova/Ergnova.csproj) —
# copied fresh from web/dist on every build, never hand-edited.
Ergnova/Resources/Raw/wwwroot/


# Web app build output / deps — see web/.gitignore for the authoritative
# list scoped to that folder; duplicated at the top two lines here so a
# `git status` from the repo root doesn't show noise from either side.
web/node_modules/
web/dist/

# IDE
.vs/
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store

# Specifics
commitsync*
reqsync*
requirements.txt

# Installer pipeline output / secrets (installer/README.md)
installer/dist/
installer/.stage/
*.keystore
*.keystore.base64.txt
*.p12
*.p8
*.mobileprovision
