<?xml version="1.0" encoding="utf-8"?>
<!--
  One context line in the expanded view: small icon, text, and an optional
  right-aligned trailing value ("Step 2/5 · Interval"  ...  "1:30 left").
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="3dp">

    <ImageView
        android:id="@+id/notif_note_icon"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/notif_note_text"
        style="@android:style/TextAppearance.Material.Notification"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/notif_note_trailing"
        style="@android:style/TextAppearance.Material.Notification.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:maxLines="1"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
